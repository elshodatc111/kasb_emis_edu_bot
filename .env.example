# ====== Telegram ======
# @BotFather dan olingan token
BOT_TOKEN=
# Asosiy adminlarning Telegram ID lari (vergul bilan). ID ni @userinfobot orqali bilib olasiz.
# Muhim: har bir admin botga kamida bir marta /start yuborgan bo'lishi kerak.
# Format: ID:Ism Familiya (bir nechta bo'lsa vergul bilan). Ism foydalanuvchilarga xodim javob yozganda shu ism bilan chiqadi.
# Masalan: ADMIN_IDS=123456789:Elshod Karimov, 987654321:Malika Aliyeva
# Bu yerdagilar "asosiy admin" hisoblanadi: faqat ular veb-paneldagi "Adminlar" bo'limi orqali yangi admin
# qo'sha/tahrirlay/o'chira oladi. Boshqa (to'liq huquqli) adminlarni endi shu faylni tahrirlamasdan,
# to'g'ridan-to'g'ri veb-panelning "Adminlar" sahifasidan qo'shishingiz mumkin.
ADMIN_IDS=

# ====== OpenAI ======
OPENAI_API_KEY=
# Storage > Vector stores dagi ID (vs_...)
OPENAI_VECTOR_STORE_ID=vs_6ab7f56d81808191b2970205eb7e22bc
# Savollarga javob beruvchi model
OPENAI_MODEL=gpt-6-luna
# Hisobot va video reja uchun model (bo'sh qolsa OPENAI_MODEL ishlatiladi), masalan gpt-6-sol
OPENAI_REPORT_MODEL=
# Ixtiyoriy: veb-paneldagi "AI xarajatlari" sahifasida OpenAI'dagi HAQIQIY kunlik xarajatni ko'rish uchun.
# Bu OPENAI_API_KEY dan BOSHQA, alohida kalit: platform.openai.com/settings/organization/admin-keys sahifasidan
# faqat tashkilot egasi (Owner) yaratadi. Bo'sh qoldirsangiz, panelda faqat bizning taxminiy hisobimiz ko'rinadi.
OPENAI_ADMIN_KEY=

# ====== Veb-panel ======
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Botning xabarlarida ko'rsatiladigan panel manzili (serverda o'zgartiring)
BASE_URL=http://127.0.0.1:8000
# Serverda HTTPS bo'lsa 1 qiling
COOKIE_SECURE=0
# Bo'sh qoldirsangiz data/.secret faylida avtomatik yaratiladi
SECRET_KEY=

# ====== Sozlamalar ======
TIMEZONE=Asia/Tashkent
DB_PATH=data/texnikum.db
# Bir foydalanuvchi daqiqasiga nechta savol berishi mumkin
RATE_LIMIT_PER_MIN=6
# AI ga yuboriladigan oldingi xabarlar soni
HISTORY_TURNS=6
# Admin suhbatni olgach, shuncha daqiqadan keyin bot avtomatik qaytadi
ADMIN_MODE_TIMEOUT_MIN=60
# Avtomatik hisobot vaqtlari (Toshkent vaqti)
DAILY_REPORT_TIME=20:00
WEEKLY_REPORT_TIME=20:30
MONTHLY_REPORT_TIME=09:00

# ====== Admin ish vaqti (foydalanuvchiga ogohlantirish uchun) ======
WORK_START=09:00
WORK_END=19:00
# 1 = dushanba ... 7 = yakshanba
WORK_DAYS=1-5

# ====== Javobsiz suhbatlar haqida adminga eslatma ======
REMIND_EVERY_MIN=10
REMIND_FROM=08:00
REMIND_TO=22:00

# ====== Kunlik test (viktorina) ======
QUIZ_START=12:20
QUIZ_END=13:00
QUIZ_SIZE=5
QUIZ_DAYS=1-7

# ====== FAQ tahlili (har kuni) ======
FAQ_TIME=21:30
